# Reference nginx TLS/mTLS front for OpenAgent. Requires nginx with ssl module.
# Distributed rate limiting/WAF may require nginx Plus, OpenResty, or external WAF.

limit_req_zone $binary_remote_addr zone=openagent_edge:10m rate=60r/m;

server {
    listen 443 ssl http2;
    server_name example.com;

    ssl_certificate /etc/nginx/tls/server.crt;
    ssl_certificate_key /etc/nginx/tls/server.key;

    # mTLS
    # ssl_client_certificate /etc/nginx/tls/client-ca.pem;
    # ssl_verify_client on;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;

    location = /events {
        limit_req zone=openagent_edge burst=20 nodelay;
        proxy_pass http://openagent:8787/events;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-Id $request_id;
        # proxy_set_header X-Client-Subject $ssl_client_s_dn;
    }

    location = /health {
        proxy_pass http://openagent:8787/health;
    }

    location / {
        return 404;
    }
}
