# OpenAgent reference deployment env

# Required for non-loopback ingress
OPENAGENT_INGRESS_TOKEN=replace-with-random-token
# Optional request signing
OPENAGENT_HMAC_SECRET=

# Basic ingress policy
OPENAGENT_ALLOWED_SESSION_PREFIXES=http:,app:
OPENAGENT_ALLOWED_SOURCES=http
OPENAGENT_RATE_LIMIT=60
OPENAGENT_MAX_TEXT_LENGTH=10000

# Model provider
OPENAGENT_PROVIDER=scripted
OPENAGENT_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# External infra (configure in your platform / shipper)
# TLS_CERT_PATH=/etc/caddy/tls/server.crt
# TLS_KEY_PATH=/etc/caddy/tls/server.key
# MTLS_CLIENT_CA_PATH=/etc/caddy/tls/client-ca.pem
# REDIS_URL=redis://redis:6379/0
# AUDIT_WORM_BUCKET=s3://my-worm-bucket/openagent-audit/
